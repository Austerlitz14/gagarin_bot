BOT_TOKEN=123:abc

# Публичный URL твоего сервиса (Render даст после деплоя)
BASE_URL=https://your-service.onrender.com

# Любая строка (секрет для webhook). Можно длиннее.
WEBHOOK_SECRET=change-me-please

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=gagarin_bot

# Список id админов через запятую (узнать id можно через /myid)
ADMIN_IDS=123456789,987654321
